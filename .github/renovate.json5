{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  labels: ['dependencies', 'ok-to-test', 'release-note-none'],
  postUpdateOptions: ['gomodTidy'],
  // kustomize is left out: release PRs bump its image tag.
  enabledManagers: ['gomod', 'github-actions', 'pip_requirements', 'custom.regex'],
  packageRules: [
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'go dependencies',
      schedule: ['before 6am on monday'],
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
      schedule: ['before 6am on the first day of the month'],
    },
    {
      matchManagers: ['pip_requirements'],
      groupName: 'docs python dependencies',
      schedule: ['before 6am on the first day of the month'],
    },
    {
      // v7.8.0 dropped the dns.RecordResponseUnion discriminator, losing MX priority and SRV data.
      // https://github.com/cloudflare/cloudflare-go/issues/4300
      matchPackageNames: ['github.com/cloudflare/cloudflare-go/v7'],
      allowedVersions: '<7.8.0',
    },
  ],
  customManagers: [
    {
      // registry.k8s.io/external-dns/external-dns:<version> in docs
      customType: 'regex',
      managerFilePatterns: ['/\\.md$/'],
      matchStrings: ['(?<depName>registry\\.k8s\\.io/external-dns/external-dns):(?<currentValue>v\\d+\\.\\d+\\.\\d+)'],
      depNameTemplate: 'kubernetes-sigs/external-dns',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      // "# renovate: datasource=... depName=..." above a *_VERSION= line
      customType: 'regex',
      managerFilePatterns: ['/^scripts/.+\\.sh$/'],
      matchStrings: ['datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*?_VERSION=(?<currentValue>.*)\\s'],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
  ],
}
