{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  semanticCommitType: 'chore',
  labels: ['dependencies', 'ok-to-test', 'release-note-none'],
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  // No kustomize or docs image refs: release PRs bump the image tag there.
  enabledManagers: ['gomod', 'github-actions', 'pip-compile', 'custom.regex'],
  // Re-runs pip-compile so new transitive dependencies get pinned with hashes.
  'pip-compile': {
    managerFilePatterns: ['/^docs/scripts/requirements\\.txt$/'],
  },
  packageRules: [
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'go dependencies',
      schedule: ['before 6am on monday'],
    },
    {
      // Indirect deps are skipped by default; keep otel contrib on the same release as otel core.
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      matchPackageNames: ['go.opentelemetry.io/**'],
      enabled: true,
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
      schedule: ['before 6am on the first day of the month'],
    },
    {
      matchManagers: ['pip-compile'],
      groupName: 'docs python dependencies',
      schedule: ['before 6am on the first day of the month'],
    },
    {
      // v7.8.0 dropped the dns.RecordResponseUnion discriminator, losing MX priority and SRV data.
      // https://github.com/cloudflare/cloudflare-go/issues/4353
      matchPackageNames: ['github.com/cloudflare/cloudflare-go/v7'],
      allowedVersions: '<7.8.0',
    },
  ],
  customManagers: [
    {
      // "# renovate: datasource=... depName=..." above a *_VERSION= line
      customType: 'regex',
      managerFilePatterns: ['/^scripts/.+\\.sh$/'],
      matchStrings: ['datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*?_VERSION=(?<currentValue>.*)\\s'],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
  ],
}
