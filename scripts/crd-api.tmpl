{{- /* Based on crdoc's markdown.tmpl, adjusted to pass the repo markdownlint config. */ -}}
# CRD API Reference

<!-- Generated by scripts/generate-crd.sh (make crd). Do not edit. -->
{{- range .Groups }}
{{- $group := . }}

## {{ .Group }}/{{ .Version }}
{{- range .Kinds }}
{{- $kind := . }}
{{- range .Types }}

{{ if .IsTopLevel }}### {{ $kind.Name }}{{ else }}#### {{ .Name }}{{ end }}

{{ if .ParentKey }}[↩ Parent](#{{ .ParentKey }})

{{ end -}}
{{ with .Description }}{{ . | html }}

{{ end -}}
<table>
  <thead>
    <tr><th>Name</th><th>Type</th><th>Description</th><th>Required</th></tr>
  </thead>
  <tbody>
{{- if .IsTopLevel }}
    <tr><td><b>apiVersion</b></td><td>string</td><td>{{ $group.Group }}/{{ $group.Version }}</td><td>true</td></tr>
    <tr><td><b>kind</b></td><td>string</td><td>{{ $kind.Name }}</td><td>true</td></tr>
    <tr><td><b><a href="https://kubernetes.io/docs/reference/kubernetes-api/common-definitions/object-meta/">metadata</a></b></td><td>object</td><td>Standard object metadata.</td><td>true</td></tr>
{{- end }}
{{- range .Fields }}
    <tr>
      <td><b>{{ if .TypeKey }}<a href="#{{ .TypeKey }}">{{ .Name }}</a>{{ else }}{{ .Name }}{{ end }}</b></td>
      <td>{{ .Type }}</td>
      <td>
        {{ .Description | html }}
{{- range .Schema.XValidations }}
        <br/><i>Validation</i>: <code>{{ .Rule | html }}</code>
        <br/><i>Message</i>: {{ .Message | html }}
{{- end }}
{{- with .Schema.Items }}{{ with .Schema }}
{{- range .XValidations }}
        <br/><i>Item validation</i>: <code>{{ .Rule | html }}</code>
        <br/><i>Message</i>: {{ .Message | html }}
{{- end }}{{ end }}{{ end }}
{{- if .Schema.Format }}
        <br/><i>Format</i>: {{ .Schema.Format }}
{{- end }}
{{- if .Schema.Pattern }}
        <br/><i>Pattern</i>: <code>{{ .Schema.Pattern | html }}</code>
{{- end }}
{{- if .Schema.Enum }}
        <br/><i>Enum</i>: {{ .Schema.Enum | toStrings | join ", " }}
{{- end }}
{{- if .Schema.Default }}
        <br/><i>Default</i>: <code>{{ .Schema.Default | toJson | html }}</code>
{{- end }}
{{- if .Schema.Minimum }}
        <br/><i>Minimum</i>: {{ .Schema.Minimum | int64 }}
{{- end }}
{{- if .Schema.Maximum }}
        <br/><i>Maximum</i>: {{ .Schema.Maximum | int64 }}
{{- end }}
{{- if .Schema.MinLength }}
        <br/><i>Min length</i>: {{ .Schema.MinLength | int64 }}
{{- end }}
{{- if .Schema.MaxLength }}
        <br/><i>Max length</i>: {{ .Schema.MaxLength | int64 }}
{{- end }}
{{- if .Schema.MaxItems }}
        <br/><i>Max items</i>: {{ .Schema.MaxItems | int64 }}
{{- end }}
      </td>
      <td>{{ .Required }}</td>
    </tr>
{{- end }}
  </tbody>
</table>
{{- end }}
{{- end }}
{{- end }}
